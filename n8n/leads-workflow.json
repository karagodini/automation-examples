{
  "name": "Заявки с сайта",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "website-lead",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "website-lead"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Secret",
              "value": "={{$env.WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.body.name, phone: $json.body.phone || null, email: $json.body.email || null, message: $json.body.message, source: $json.body.source || 'n8n' }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-2222-4222-8222-222222222222",
      "name": "Leads webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "=Новая заявка с сайта\nИмя: {{$json.body.name}}\nТелефон: {{$json.body.phone}}\nEmail: {{$json.body.email}}\nСообщение: {{$json.body.message}}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1b2c3d4-3333-4333-8333-333333333333",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [560, 520],
      "disabled": true,
      "credentials": {
        "telegramApi": {
          "id": "set-in-n8n",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.GOOGLE_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Имя": "={{$json.body.name}}",
            "Телефон": "={{$json.body.phone}}",
            "Email": "={{$json.body.email}}",
            "Сообщение": "={{$json.body.message}}",
            "Источник": "={{$json.body.source || 'n8n'}}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-4444-4444-8444-444444444444",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [820, 520],
      "disabled": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "set-in-n8n",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Leads webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}

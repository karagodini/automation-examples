# Скопируйте в .env и заполните нужные поля.
# Без Telegram-токена оба примера печатают сводку в консоль.

# --- Telegram (общее) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- price-monitor ---
# Стартовая страница каталога. У books.toscrape.com страницы: .../catalogue/page-1.html
CATALOGUE_URL=https://books.toscrape.com/catalogue/page-1.html
# Сколько страниц обойти за запуск. В каталоге-песочнице их 50.
MAX_PAGES=2
# Пауза между страницами, секунды.
REQUEST_DELAY=0.4
# Каталог для Excel, CSV и снимка. По умолчанию price-monitor/data
# DATA_DIR=

# --- leads-webhook ---
# Куда дописывать заявки. По умолчанию leads-webhook/data/leads.xlsx
# LEADS_XLSX_PATH=
# Если задан, POST /leads требует заголовок X-Webhook-Secret.
WEBHOOK_SECRET=

# Необязательно: Google Sheets через сервисный аккаунт.
# Файл ключа JSON не коммитьте.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Leads

# Необязательно: классификация заявки через OpenAI-совместимый API
# (OpenRouter, Groq, Ollama и т.п.). В модель уходят имя, источник и текст,
# без телефона и email. Если адрес или модель пустые — работают правила по словам.
# Примеры базового URL:
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   http://127.0.0.1:11434/v1
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=
